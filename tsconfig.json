{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out",

    "target": "es2019",
    "lib": ["es2019", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@alias/*": ["tests/crossComponent/*"]
    },

    "types": ["mocha", "node", "glob", "react", "react-dom"],
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"],
  "exclude": ["out", "node_modules"]
}
