{
  "name": "zemdomu",
  "version": "1.2.0",
  "description": "Semantic HTML linter for HTML, JSX, and TSX. Detects accessibility, SEO, and structure issues before deployment.",
  "main": "./out/index.js",
  "bin": {
    "zemdomu": "./out/cli.js"
  },
  "files": [
    "out"
  ],
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run compile && mocha out/**/*.test.js"
  },
  "keywords": [
    "html",
    "jsx",
    "tsx",
    "linter",
    "accessibility",
    "semantic-html",
    "seo",
    "cli",
    "vscode",
    "github-action"
  ],
  "author": "Zacharias Eryd Berlin",
  "license": "ISC",
  "devDependencies": {
    "@types/babel__traverse": "^7.20.7",
    "@types/babel-traverse": "^6.25.10",
    "@types/babel-types": "^7.0.16",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "mocha": "^10.8.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "@babel/types": "^7.27.0",
    "glob": "^7.2.3"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
