{
  "name": "zemdomu",
  "version": "1.3.19",
  "description": "Semantic HTML linter for HTML, JSX, TSX, and Vue templates. Detects accessibility, SEO, and structure issues before deployment.",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "bin": {
    "zemdomu": "./out/cli.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./*": "./out/*"
  },
  "files": [
    "out",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "private": false,
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npm run compile && mocha out/**/*.test.js",
    "posttest": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});\""
  },
  "keywords": [
    "html",
    "jsx",
    "tsx",
    "vue",
    "linter",
    "accessibility",
    "semantic-html",
    "seo",
    "cli",
    "vscode",
    "github-action"
  ],
  "author": "Zacharias Eryd Berlin",
  "license": "ISC",
  "funding": "https://buymeacoffee.com/zemdomu",
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/babel-traverse": "^6.25.10",
    "@types/babel-types": "^7.0.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "glob": "^11.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.9",
    "brace-expansion": "5.0.9",
    "diff": "8.0.3",
    "glob@^10.0.0": "10.5.0",
    "js-yaml@^4.0.0": "4.3.1",
    "minimatch@^9.0.0": "9.0.7",
    "minimatch@^10.0.0": "10.2.4",
    "serialize-javascript@^6.0.2": "7.0.5"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
