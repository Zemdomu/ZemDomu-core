{
  "name": "zemdomu",
  "version": "1.4.1",
  "description": "Semantic accessibility static analysis for HTML, JSX, TSX, and Vue, with supported cross-component structure.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zemdomu/ZemDomu-core.git"
  },
  "homepage": "https://zemdomu.dev/",
  "bugs": {
    "url": "https://github.com/Zemdomu/ZemDomu-core/issues"
  },
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "bin": {
    "zemdomu": "./out/cli.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./*": "./out/*"
  },
  "files": [
    "out",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "private": false,
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test:accuracy-corpus": "npm run compile && mocha out/tests/accuracy-corpus.test.js",
    "accuracy-corpus:prepare": "npm run compile && node out/tests/accuracy-corpus/run.js",
    "accuracy-corpus:seed": "npm run compile && node out/tests/accuracy-corpus/seed-run.js",
    "accuracy-corpus:axe": "npm run compile && node out/tests/accuracy-corpus/axe-run.js",
    "accuracy-corpus:study": "npm run compile && node out/tests/accuracy-corpus/study-run.js",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "prepublishOnly": "npm run build",
    "test": "npm run compile && mocha out/**/*.test.js",
    "posttest": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});\""
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "semantic-html",
    "html",
    "jsx",
    "tsx",
    "react",
    "vue",
    "static-analysis",
    "linter",
    "cli",
    "vscode",
    "github-action"
  ],
  "author": "Zacharias Eryd Berlin",
  "license": "ISC",
  "funding": "https://buymeacoffee.com/zemdomu",
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.4",
    "mocha": "^12.0.0",
    "react": "^19.2.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "glob": "^11.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.9",
    "brace-expansion": "5.0.9",
    "diff": "8.0.3",
    "glob@^10.0.0": "10.5.0",
    "js-yaml@^4.0.0": "4.3.1",
    "minimatch@^9.0.0": "9.0.7",
    "minimatch@^10.0.0": "$minimatch",
    "serialize-javascript@^6.0.2": "7.0.5"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
